<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Security: Deny direct access to sensitive and configuration files
<FilesMatch "^\.(env|git|editorconfig)">
    Require all denied
</FilesMatch>
<FilesMatch "\.(zip|sql|json|lock|xml|example|log|bak|orig)$">
    Require all denied
</FilesMatch>
